NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

REDIS_URL=redis://localhost:6379
BULK_JOB_CONCURRENCY=1
WA_RATE_LIMIT_PER_SECOND=5
WA_RATE_LIMIT_PER_MINUTE=300

# Conversational Chat Session Inactivity Timeout in Minutes (Default: 20)
CHAT_SESSION_TIMEOUT_MINUTES=20

ADMIN_SECRET_KEY=replace_with_strong_random_secret
ADMIN_ACCESS_TOKEN_SECRET=replace_with_strong_random_access_secret
ADMIN_REFRESH_TOKEN_SECRET=replace_with_strong_random_refresh_secret
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_REFRESH_COOKIE_MAX_AGE_MS=604800000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

WA_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WA_APP_ID=your_meta_app_id
WA_WEBHOOK_VERIFY_TOKEN=replace_with_strong_webhook_verify_token

COA_WELCOME_IMAGE=https://example.com/path/to/welcome-image.png

HELPLINE_EMAIL=support@example.com
HELPLINE_NUMBER=011-00000000
COURIER_COMPANY_NAME=India Post

API_BASE_URL=https://coa.brandforce360.com/api/external/whatsapp
WHATSAPP_BASIC_AUTH_USERNAME=coa-erp-portal
WHATSAPP_BASIC_AUTH_PASSWORD=your_basic_auth_password_here

# Scheduled Proactive Notifications (Kill-switch: default false)
ENABLE_DAILY_RENEWAL_CRON=false

# Bulk Background Job Recovery (Safe startup: default false)
AUTO_RESUME_BULK_JOBS_ON_STARTUP=false
BULK_JOB_RESUME_MAX_AGE_HOURS=24

