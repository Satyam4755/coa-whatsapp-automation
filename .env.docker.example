ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_REFRESH_COOKIE_MAX_AGE_MS=604800000

CLOUDINARY_CLOUD_NAME=your_cloud_name
